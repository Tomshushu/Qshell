{
  "name": "qshell",
  "private": true,
  "version": "1.0.14",
  "description": "Qshell - 现代化极速终端与服务器管理工作台 (Tauri + Rust)",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "build": "npm run check:undefined && tsc --noEmit && vite build",
    "build:tauri": "tauri build",
    "build:win": "tauri build --bundles nsis",
    "build:win:zip": "npm run build:win && node tools/build-win-zip.mjs",
    "build:mac": "tauri build --bundles dmg,app",
    "build:linux": "tauri build --bundles deb,appimage,rpm",
    "build:all": "tauri build",
    "lint": "eslint .",
    "check:undefined": "node tools/check-undefined.mjs",
    "preview": "vite preview",
    "site:dev": "vite website --port 5180",
    "site:build": "vite build website",
    "site:preview": "vite preview website --port 5180",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:native": "cd src-tauri && cargo test",
    "sync:gitee": "node tools/sync-gitee-release.mjs",
    "version:sync": "node tools/bump-version.mjs",
    "bump": "node tools/bump-version.mjs"
  },
